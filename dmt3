    p["ports"].add_argument("--http", type=int, metavar="PORT", help="Caddy's plain HTTP port while exposed (80)")
    p["ports"].add_argument("--https", type=int, metavar="PORT", help="Caddy's HTTPS port while exposed (443)")
    p["expose"].add_argument("name", nargs="?", help="the site's name (dmt3.example.org), which leads to this PC")
    p["expose"].add_argument("--email", help="the address Let's Encrypt writes to about the certificate")
