def wizard():
    """The setup wizard's module (packaging/docker/wizard.py), loaded from its path."""
    import importlib.util
    spec = importlib.util.spec_from_file_location("dmt3_wizard", os.path.join(ROOT, WIZARD))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def lan_addresses():
    """This PC's addresses on its networks as (address, interface), the one with the default route first; Docker's
    own bridges, loopback and WSL's own inner address left out (other PCs never reach those)."""
    found = []
    code, out = run(["ip", "-4", "-o", "addr", "show"], capture=True) if shutil.which("ip") else (1, "")
    if code == 0:
        for line in out.splitlines():
            parts = line.split()
            # "2: eth0    inet 192.168.0.2/24 brd ..."
            if len(parts) >= 4 and parts[2] == "inet":
                name, address = parts[1], parts[3].split("/")[0]
                if name == "lo" or name.startswith(("docker", "br-", "veth")) or address.startswith("127."):
                    continue
                found.append((address, name))
    # The address the default route leaves from (no packet is sent: a UDP socket only picks its way).
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("192.0.2.1", 9))
            main = s.getsockname()[0]
    except OSError:
        main = None
    if main and not main.startswith("127.") and main not in [a for a, _ in found]:
        found.append((main, "the default route"))
    # The default route's first, then the rest as found; this PC alone last.
    found.sort(key=lambda item: item[0] != main)
    return found + [("127.0.0.1", "this PC only")]


def usual_places():
    """The folders people keep a game in: Desktop, Downloads and Documents of this PC's users, Windows' ones too
    under WSL (and under OneDrive there)."""
    homes = [os.path.expanduser("~")]
    # Under sudo, ~ is root's; the person's own folders are under SUDO_USER's home.
    if os.environ.get("SUDO_USER"):
        homes.append(os.path.expanduser("~" + os.environ["SUDO_USER"]))
    homes += sorted(glob.glob("/mnt/c/Users/*"))
    places = []
    for home in homes:
        for name in ("Desktop", "Downloads", "Documents", "OneDrive/Desktop", "OneDrive/Documents"):
            places.append(os.path.join(home, name))
    return [p for p in dict.fromkeys(places) if os.path.isdir(p)]


def found_games(places=None, depth=4, budget=6.0):
    """Game folders at or below the usual places, up to `depth` levels down, looked for for at most `budget`
    seconds (Windows' drives under WSL are slow to list)."""
    library()
    from opendmt3.core.game import Game
    found, until = [], time.monotonic() + budget
    for base in places if places is not None else usual_places():
        top = base.rstrip(os.sep).count(os.sep)
        for here, dirs, names in os.walk(base):
            if time.monotonic() > until:
                return found
            # The archives' folder is large and holds no game folder; hidden folders hold none either.
            dirs[:] = sorted(d for d in dirs if d.lower() != "pack" and not d.startswith("."))
            if here.count(os.sep) - top >= depth:
                dirs[:] = []
            try:
                if "pack" in (n.lower() for n in os.listdir(here)) and Game._looks_like_game(here):
                    found.append(here)
                    # A game folder holds no other.
                    dirs[:] = []
            except OSError:
                continue
    return found


class FrontDoor:
    """What the wizard's pages look at and do on this PC, with the front door's own functions."""

    def __init__(self):
        # Each path's look, by the path and the password tried (reading a game folder's indexes takes a second).
        self.surveyed = {}

    def docker_checks(self):
        # The volume line is the doctor's; the wizard needs only what stops a setup.
        return [c for c in doctor_checks() if c[1] is not None]

    def addresses(self):
        return lan_addresses()

    def accounts(self):
        """How many accounts the database has: 0 without a data volume, None when it cannot be told yet."""
        if run(["docker", "volume", "inspect", "%s_data" % PROJECT], capture=True)[0] != 0:
            return 0
        if run(["docker", "image", "inspect", IMAGE], capture=True)[0] != 0:
            # Counted in the image, which is not built yet; the setup counts again before it makes one.
            return None
        code, out = run(count_accounts(), capture=True)
        return int(out.strip().splitlines()[-1]) if code == 0 and out.strip() else None

    def survey(self, path, password=None):
        """What a path is (look()): kept by the path and the password, so each is looked at once."""
        key = (os.path.abspath(path), password)
        if key not in self.surveyed:
            self.surveyed[key] = look(path, password)
        return self.surveyed[key]

    def lines(self, found):
        """A look's lines: its one line, then its parts."""
        return [(found["ready"], found["line"])] + list(found["parts"])

    def mounts(self, path):
        mounts, refused = game_mounts(path)
        return mounts, refused, server_can_read(path)

    def found_games(self):
        """The game's files in the usual places, each with its line (sources.found, as the Status page's list)."""
        library()
        from opendmt3.server.services import sources
        found = sources.found(usual_places())
        for item in found:
            if item.get("key") == "error.source.no_7zip":
                # Opened by the server's own 7-Zip during the setup.
                item.update(ready=True, line="An archive: the server's own 7-Zip looks into it when it reads it")
        return found

    def default_installer(self):
        return default_installer()

    def installer_info(self, path):
        if not os.path.isfile(path):
            return None
        library()
        from opendmt3.server.services import downloads
        return {"size": os.path.getsize(path), "version": downloads.version(path)}

    def build_command(self):
        return compose("build", SERVICE)

    def plan(self, a):
        """The front door's steps for the wizard's answers (an archive's password, when one was typed, goes to the
        server's container by the environment's name: catalog_command)."""
        if getattr(a, "archive_password", ""):
            os.environ[PASSWORD_ENV] = a.archive_password
        # The build's installer, the file typed, or "" for none (setup_plan takes "" as none).
        installer = {"build": default_installer(), "file": a.installer_path()}.get(a.installer) or ""
        args = argparse.Namespace(admin=a.admin.strip().upper(), password=a.password or None, game=a.game_path(),
                                  installer=os.path.abspath(installer) if installer else "", no_start=False,
                                  keep_game=False)
        return setup_plan(args, a.accounts)

    def keep_game(self, folder):
        game_dir, links = kept_game(folder)
        write_env({"GAME_DIR": game_dir, "GAME_LINKS": links or None})

    def keep_address(self, address):
        """The address chosen on the wizard's Address page, kept for the server (keep_address)."""
        keep_address(address)

    def stream(self, cmd, on_line):
        """A command, each line of its output to on_line as it comes; (exit code, every line)."""
        lines = []
        try:
            child = subprocess.Popen(cmd, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                     stdin=subprocess.DEVNULL, text=True, errors="replace")
        except FileNotFoundError:
            return 127, ["%s is not installed" % cmd[0]]
        for line in child.stdout:
            lines.append(line.rstrip("\n"))
            on_line(line)
        return child.wait(), lines

    def check(self, wait=90):
        """The running server's /health and game port, after waiting up to `wait` seconds for the site to answer;
        each as (ok, text)."""
        until = time.monotonic() + wait
        while time.monotonic() < until:
            code, out = run(compose("port", SERVICE, str(WEB_PORT)), capture=True)
            if code == 0 and out.strip():
                host, port = published(out)
                try:
                    with urllib.request.urlopen("http://%s:%d/health" % (host, port), timeout=3):
                        break
                except (OSError, urllib.error.HTTPError):
                    pass
            time.sleep(1)
        # cmd_check's own lines, read back.
        captured = io.StringIO()
        with contextlib.redirect_stdout(captured):
            cmd_check(None)
        out = []
        for line in captured.getvalue().splitlines():
            if line.startswith("  ok"):
                out.append((True, line[8:].strip()))
            elif line.startswith("  FAIL"):
                out.append((False, line[8:].strip()))
        return out


# The libraries the site's and the API's tests need; a Python without them skips those tests.
SITE_LIBRARIES = ("starlette", "jinja2", "multipart", "uvicorn", "httpx")


def cmd_test(args):
    """Unit tests, the boundary test and pyflakes; the first that fails ends the run with its code."""
    python = args.python or sys.executable
    # Said before the run: which tests this Python leaves out, and how to run them all.
    probe = "import importlib.util, sys; print(' '.join(m for m in sys.argv[1:] if not importlib.util.find_spec(m)))"
    missing = run([python, "-c", probe] + list(SITE_LIBRARIES), capture=True)[1].strip()
    if missing:
        say("the site's and the API's tests are skipped: %s has no %s (./dmt3 test --python PATH runs them with "
            "another Python)" % (python, ", ".join(missing.split())))
    for name, cmd in test_commands(python, args.one_process, args.jobs):
        say("== %s" % name)
        if name == "pyflakes":
            code, out = run(cmd, capture=True)
            if "No module named pyflakes" in out:
                die("pyflakes is not installed for %s: %s -m pip install pyflakes" % (python, python))
            # Any line beyond the known one fails the run.
            extra = unexpected_lint(out)
            for line in extra:
                say(line)
            if extra:
                return 1
            say("  no new lines (%s, known)" % KNOWN_LINT)
            continue
        code = run(cmd)[0]
        if code != 0:
            return code
    return 0


