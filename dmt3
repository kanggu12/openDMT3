    p["remove"].add_argument("--yes", action="store_true", help="do not ask before --delete-data")
    p["ports"].add_argument("--game", type=int, metavar="PORT", help="the game's port (TCP; 4725 by default)")
    p["ports"].add_argument("--web", type=int, metavar="PORT",
