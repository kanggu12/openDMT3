class _Help(argparse.HelpFormatter):
    """argparse's help, its lines never broken inside a name (openDMT3-song-list.zip, --keep-game): only at spaces,
    as the launcher's own help is."""

    def _split_lines(self, text, width):
        # argparse's own wrap breaks at hyphens too; a file's name must stay whole to be read and typed.
        import textwrap
        return textwrap.wrap(" ".join(text.split()), width, break_on_hyphens=False)


def parser():
    """The command line: one subcommand each, in the order ./dmt3 lists them."""
    ap = argparse.ArgumentParser(prog="dmt3", formatter_class=_Help,
                                 description="Run an openDMT3 server with Docker Compose, and build and test this "
                                             "tree.")
    sub = ap.add_subparsers(dest="command", metavar="<command>")
    # Made in COMMANDS' order, so --help lists them as ./dmt3 alone does.
    p = {name: sub.add_parser(name, help=text, formatter_class=_Help) for name, text in COMMANDS}
    p["setup"].add_argument("--address", metavar="ADDRESS",
                            help="this PC's address as the players reach it (192.168.0.5, a name, or a whole "
                                 "https://... address behind a proxy): the message to send a player carries it")
    p["setup"].add_argument("--game", metavar="PATH",
                            help="import the song list from your game folder, an archive holding it, or a song list "
                                 "the launcher saved")
    p["setup"].add_argument("--admin", metavar="ID", default="BOSS", help="the first account's ID (BOSS when not given)")
    p["setup"].add_argument("--installer", metavar="FILE",
                            help="the installer to hand out (by default the one ./dmt3 build left, when there is one)")
    p["setup"].add_argument("--password", help="the first account's password (made and printed when not given)")
    p["setup"].add_argument("--keep-game", action="store_true",
                            help="keep the game folder mounted read-only, so the Song list tab can import it again")
    p["setup"].add_argument("--no-start", action="store_true", help="set up without starting the server")
    p["catalog"].add_argument("game", nargs="?", metavar="PATH",
                              help="your game folder (or one above it), an archive holding it, or a song list the "
                                   "launcher saved (the game folder kept mounted, GAME_DIR in .env, when not given)")
    p["catalog"].add_argument("--save", metavar="FILE",
                              help="save the song list into FILE (or a folder: openDMT3-song-list.zip in it) instead of "
                                   "importing it, for a server elsewhere")
    p["up"].add_argument("--no-build", action="store_true", help="start from the image as it is")
    p["logs"].add_argument("-f", "--follow", action="store_true", help="keep showing new lines")
    p["logs"].add_argument("-n", "--tail", type=int, default=200, help="how many of the last lines (200)")
    p["restore"].add_argument("name", help="a backup's name, as ./dmt3 backups lists it")
    p["add-player"].add_argument("id", help="the account's ID, for the site and the launcher")
    p["add-player"].add_argument("--password", help="its password (made and printed when not given)")
    p["add-player"].add_argument("--dj", metavar="NAME", help="its DJ name (the ID when not given)")
    p["add-player"].add_argument("--admin", action="store_true", help="with the admin pages")
    p["build"].add_argument("out", nargs="?", default=BUILD_DIR, help="the output folder (build/windows)")
    p["test"].add_argument("--python", metavar="PATH",
                           help="the Python that runs the tests, with the site's libraries (this one when not given)")
    p["test"].add_argument("--one-process", action="store_true",
                           help="every unit test in one process, one after another (they run on several at once)")
    p["test"].add_argument("--jobs", type=int, default=0, metavar="N",
                           help="the unit tests on N processes at once (default: the cores, at most eight)")
    return ap


def usage():
    """The list of commands, for ./dmt3 alone."""
    width = max(len(name) for name, _ in COMMANDS)
    lines = ["usage: ./dmt3 <command> [options]   (./dmt3 <command> --help for its options)", ""]
    lines += ["  %-*s  %s" % (width, name, text) for name, text in COMMANDS]
    return "\n".join(lines)


def asked_nothing(argv):
    """True when the command line was `setup` and nothing else."""
    return list(sys.argv[1:] if argv is None else argv) == ["setup"]


def main(argv=None):
    args = parser().parse_args(argv)
    if not args.command:
        # ./dmt3 alone lists what it does.
        say(usage())
        return 0
    if args.command == "setup" and asked_nothing(argv) and sys.stdin.isatty() and sys.stdout.isatty():
        # ./dmt3 setup alone, at a terminal: the wizard. With options, or from a script, it runs as before.
        return wizard().run(FrontDoor())
    special = {"setup": cmd_setup, "catalog": cmd_catalog, "check": cmd_check, "doctor": cmd_doctor,
               "test": cmd_test}
    if args.command in special:
        return special[args.command](args)
    # Only the commands that reach the database need to know whether the container is up.
    running = is_running() if args.command in ("backup", "backups", "restore", "add-player") else False
    code = run(simple_command(args, running))[0]
    if args.command == "status" and code == 0:
        # The health beside the container's state, then where the site is (the address to open and to send).
        code = cmd_check(args)
        where = site_lines()
        if where:
            say(where)
    return code


if __name__ == "__main__":
    # Piping into `head` and the like ends quietly instead of with a BrokenPipeError traceback. Only when run as the
    # program: the unit tests load this file as a module (tests/test_front_door.py), and their process must keep
    # Python's own handling, where a write to a closed socket is an error, not the end of the process.
    if hasattr(signal, "SIGPIPE"):
        # Where there is such a signal: Windows' Python has none (there a closed pipe is an error of its own).
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main())
