def last_backup_out():
    """A backup made now, read out of the data volume into this clone's folder (opendmt3-backup-<time>.sqlite), before
    the volume goes; its path, or None when there is no database."""
    script = ("set -e; [ -f /data/openDMT3.sqlite ] || exit 3; python -m opendmt3.server --data /data --backup >&2; "
              "cat \"$(ls -t /data/backups/*.sqlite | head -n 1)\"")
    try:
        done = subprocess.run(compose("run", "--rm", "-T", "--no-deps", "--entrypoint", "sh", SERVICE, "-c", script),
                              cwd=ROOT, stdout=subprocess.PIPE)
    except FileNotFoundError:
        die("docker is not installed; run ./dmt3 doctor")
    if done.returncode == 3:
        return None
    if done.returncode != 0 or not done.stdout.startswith(b"SQLite format 3"):
        die("the backup could not be read out of the data folder: nothing was deleted")
    path = os.path.join(ROOT, "opendmt3-backup-%s.sqlite" % time.strftime("%Y%m%d-%H%M%S"))
    with open(path, "wb") as f:
        f.write(done.stdout)
    return path


