                                 "it again")
    p["setup"].add_argument("--no-start", action="store_true", help="set up without starting the server")
    p["setup"].add_argument("--game-port", type=int, metavar="PORT", help="the game's port (4725), as ./dmt3 ports")
    p["setup"].add_argument("--web-port", type=int, metavar="PORT", help="the site's port (4730), as ./dmt3 ports")
    p["catalog"].add_argument("game", nargs="?", metavar="PATH",
                              help="your client data's folder (or one above it), an archive holding it, or a song "
                                   "list the launcher saved (the folder kept mounted, GAME_DIR in .env, when not "
                                   "given)")
    p["catalog"].add_argument("--save", metavar="FILE",
