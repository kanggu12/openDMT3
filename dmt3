def cmd_image(args):
    """./dmt3 image: the server image the server runs, made ready. --build builds this clone's and keeps it;
    --published goes back to the published one of this version. Without either, the image already chosen: pulled
    when it is the published one and not here yet, built when that cannot be (no network, or a version not
    published, as a clone past its release is)."""
    if args.build:
        return build_image()
    if args.published:
        # Back to the published image: .env names none, so Compose and ./dmt3 take this version's.
        write_env({IMAGE_ENV: None})
        os.environ.pop(IMAGE_ENV, None)
    image = chosen_image()
    if has_image(image):
        say("the server image: %s" % image)
        return 0
    if image != published_image():
        # The clone's own image (or one named in .env) is missing: only a build makes it.
        return build_image()
    say("pulling the server image %s" % image)
    if run(["docker", "pull", image])[0] == 0:
        return 0
    if args.published:
        # Asked for by name: no build stands in for it.
        return 1
    say("the published image %s could not be pulled: building it from this clone instead" % image)
    return build_image()


def edge_module():
    """This clone's Caddyfile maker (opendmt3/server/edge.py, plain Python), shared with the server's own command line."""
    library()
    from opendmt3.server import edge
    return edge


def cmd_expose(args):
    """./dmt3 expose NAME: the site over HTTPS at NAME, behind Caddy beside the server, its certificate got and renewed
    by Caddy (Let's Encrypt, its staging authority, another ACME authority, or Caddy's own local one on a closed
    network). --off goes back to the site on its own port; alone it says how the site is reached now."""
    if args.root_cert:
        # Caddy's local authority's root, for the players' PCs to trust once (docs/closed-network.md).
        code, out = run(compose("exec", "-T", EDGE_SERVICE, "cat", EDGE_ROOT_CERT), capture=True)
        if code != 0 or "BEGIN CERTIFICATE" not in out:
            die("Caddy has no local authority yet: ./dmt3 expose NAME --local-ca, then ./dmt3 up")
        with open(args.root_cert, "w", encoding="ascii") as f:
            f.write(out[out.index("-----BEGIN"):])
        say("Caddy's local root certificate: %s" % os.path.abspath(args.root_cert))
        return 0
    if args.off:
        if not exposed():
            say("The site is not exposed: it is on its own port, %d." % web_port())
            return 0
        # .env names no site any more: Compose reads compose.yaml alone, and Caddy, no longer in it, goes.
        write_env({"EDGE_NAME": None, "SITE_ADDRESS": None})
        say("The site is on its own port again, %d." % web_port())
        return run(compose("up", "-d", "--no-build", "--pull", "never", "--remove-orphans"))[0] if is_running() else 0
    if not args.name:
        say("The site: https://%s/ through Caddy." % exposed() if exposed() else
            "The site is on its own port, %d: ./dmt3 expose NAME puts it on HTTPS at NAME." % web_port())
        return 0
    edge = edge_module()
    ca_root = None
    if args.ca_root:
        if not args.ca:
            die("--ca-root goes with --ca URL (the private authority whose root it is)")
        os.makedirs(EDGE_DIR, exist_ok=True)
        shutil.copyfile(args.ca_root, os.path.join(EDGE_DIR, "ca-root.pem"))
        # Where edge.yaml mounts .edge/ inside Caddy's container.
        ca_root = "/etc/caddy/ca-root.pem"
    try:
        name = edge.check_name(args.name, args.local_ca)
        text = edge.caddyfile(name, "127.0.0.1:%d" % web_port(), email=args.email,
                              ca="staging" if args.staging else args.ca, ca_root=ca_root, local_ca=args.local_ca)
    except edge.EdgeError as e:
        die(str(e))
    os.makedirs(EDGE_DIR, exist_ok=True)
    with open(os.path.join(EDGE_DIR, "Caddyfile"), "w", encoding="utf-8") as f:
        f.write(text)
    # Kept in .env: from now on every ./dmt3 command reads edge.yaml too, and the server tells players this address.
    write_env({"EDGE_NAME": name, "SITE_ADDRESS": "https://%s/" % name})
    say("The players' address: https://%s/" % name)
    say("Caddy's settings: %s" % os.path.join(EDGE_DIR, "Caddyfile"))
    if is_running():
        # The server again with the site on this PC only, and Caddy beside it.
        code = run(compose("up", "-d", "--no-build", "--pull", "never"))[0]
        # Caddy reads its Caddyfile when it starts: a running one (another name, another authority) starts again.
        code = code or run(compose("restart", EDGE_SERVICE))[0]
        if code:
            return code
        say("Caddy gets the certificate now; ./dmt3 check says when the site answers over HTTPS.")
    else:
        say("./dmt3 up starts the server with Caddy beside it.")
    say("On the router: forward TCP 80 and 443 (Caddy) and TCP %d (the game) to this PC%s." % (
        game_port(), "" if not args.local_ca else "; on a closed network, players' PCs trust Caddy's root certificate "
                                                "once (./dmt3 expose --root-cert FILE saves it)"))
    return 0


def cmd_ports(args):
    """./dmt3 ports: the game's port and the site's (and Caddy's, while the site is exposed), kept in .env and used by
    every command, compose.yaml and the server alike; a running server starts again on the new ones."""
    wanted = {GAME_PORT_ENV: args.game, WEB_PORT_ENV: args.web, "HTTP_PORT": args.http, "HTTPS_PORT": args.https}
    for name, value in wanted.items():
        if value is not None and not 1 <= value <= 65535:
            die("%d is no TCP port (1 to 65535)" % value)
    changes = {name: (None if value == default else str(value)) for (name, value), default in
               zip(wanted.items(), (GAME_PORT, WEB_PORT, 80, 443)) if value is not None}
    old_web = web_port()
    if changes:
        write_env(changes)
    env = read_env()
    numbers = [game_port(), web_port()] + ([int(env.get("HTTP_PORT") or 80), int(env.get("HTTPS_PORT") or 443)]
                                           if exposed() else [])
    if len(set(numbers)) != len(numbers):
        # Undone: two parts on one port would leave one of them unreachable.
        write_env({name: env.get(name) if name not in changes else None for name in changes})
        die("each part needs a port of its own: %s" % ", ".join(str(n) for n in numbers))
    if changes and exposed() and web_port() != old_web:
        # Caddy reaches the site on its port: its Caddyfile follows.
        path = os.path.join(EDGE_DIR, "Caddyfile")
        with open(path, encoding="utf-8") as f:
            text = f.read().replace("reverse_proxy 127.0.0.1:%d" % old_web, "reverse_proxy 127.0.0.1:%d" % web_port())
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
    say("The game's port: %d (TCP). The site's port: %d (the site, the admin pages and the API)." % (
        game_port(), web_port()))
    if exposed():
        say("Caddy: HTTP %s, HTTPS %s." % (env.get("HTTP_PORT") or 80, env.get("HTTPS_PORT") or 443))
    if changes and is_running():
        # The server again on the new ports (and Caddy, which reads its Caddyfile when it starts).
        code = run(compose("up", "-d", "--no-build", "--pull", "never"))[0]
        if exposed():
            code = code or run(compose("restart", EDGE_SERVICE))[0]
        return code
    return 0


