; The plain export names the game imports, each mapped to its __stdcall decorated symbol; then the three calls
; openDMT3's own multiDLL.dll makes for the game's touch screen (touch.c, __cdecl, so their names are plain).
LIBRARY CRT_R1.dll
EXPORTS
CommOpen=CommOpen@4
CommClose=CommClose@4
CommSetting=CommSetting@8
CRT286_GetStatus=CRT286_GetStatus@8
CRT286_Eject=CRT286_Eject@4
RF_DetectCard=RF_DetectCard@4
RF_GetCardID=RF_GetCardID@8
RF_LoadSecKey=RF_LoadSecKey@16
RF_ReadBlock=RF_ReadBlock@16
RF_WriteBlock=RF_WriteBlock@16
openDMT3_touch_open
openDMT3_touch_read
openDMT3_touch_close
